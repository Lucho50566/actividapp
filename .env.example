# ===== Actividapp - configuración =====
# Copiá este archivo a .env dentro de /server y completá la API key.

PORT=3100
HOST=0.0.0.0

# Proveedor de IA de visión: gemini | anthropic | openai | none
# "none" = modo demo (sin llamadas a IA, carga una actividad de ejemplo).
AI_PROVIDER=gemini

# --- Gemini (recomendado, tiene capa gratuita) ---
# Conseguí la key en https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
